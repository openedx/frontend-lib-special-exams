{
  "name": "@edx/frontend-lib-special-exams",
  "version": "1.14.0",
  "description": "Special exams lib",
  "main": "dist/index.js",
  "release": {
    "branches": [
      "main"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./testing": "./dist/testing/index.js"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openedx/frontend-lib-special-exams.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "make build",
    "prepublishOnly": "npm run build",
    "semantic-release": "semantic-release",
    "i18n_extract": "formatjs extract --format ./i18n/formatter.js --ignore 'src/**/*.json' --out-file ./src/i18n/transifex_input.json 'src/**/*.js*' 'src/**/*.ts*'",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "snapshot": "jest --updateSnapshot",
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --passWithNoTests --watch",
    "types": "tsc --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "license": "AGPL-3.0",
  "homepage": "https://github.com/openedx/frontend-lib-special-exams",
  "bugs": {
    "url": "https://github.com/openedx/frontend-lib-special-exams/issues"
  },
  "dependencies": {
    "eventemitter3": "^4.0.7"
  },
  "peerDependencies": {
    "@openedx/paragon": "^23.0.0",
    "@tanstack/react-query": "^5.0.0",
    "prop-types": "^15.7.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.24.9",
    "@babel/preset-env": "7.24.8",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "^7.24.7",
    "@edx/eslint-config": "^4.3.0",
    "@edx/typescript-config": "1.1.0",
    "@formatjs/cli": "^6.0.3",
    "@openedx/paragon": "^23.23.0",
    "@tanstack/react-query": "5.90.19",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "5.10.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.13",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "axios": "1.8.4",
    "axios-mock-adapter": "1.18.2",
    "babel-jest": "29.7.0",
    "eslint": "8.44.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.18.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "husky": "3.1.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "10.2.2",
    "rosie": "2.0.1",
    "semantic-release": "^20.1.3",
    "typescript": "4.9.5"
  }
}
